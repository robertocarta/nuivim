{
  "name": "propvim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "playwright test",
    "harness": "tsx tests/e2e/harness.ts",
    "test": "npm run lint && npm run typecheck && npm run test:unit && npm run test:rust && npm run test:e2e"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "ws": "^8.22.0"
  }
}
