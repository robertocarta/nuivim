{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NuiVim",
  "version": "0.1.0",
  "identifier": "app.nuivim",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "NuiVim",
        "width": 1000,
        "height": 720,
        "minWidth": 320,
        "minHeight": 200
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "public.app-category.developer-tools",
    "shortDescription": "Neovim with proportional prose",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "fileAssociations": [
      { "ext": ["md", "markdown", "txt", "tex", "rst", "org", "norg", "typ", "adoc"], "name": "Text document", "role": "Editor" }
    ],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
